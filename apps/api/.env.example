NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://marketplace:marketplace@localhost:5435/marketplace
REDIS_URL=redis://localhost:6379
# Development-only secrets. MUST be overridden in production.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-00000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
WEB_APP_URL=http://localhost:3000
MESSAGE_PROVIDER=console
VERIFICATION_CODE_TTL_MINUTES=15
RATE_LIMIT_ENABLED=true

# Storage (media). local = filesystem via the API; s3 = S3/R2/MinIO.
STORAGE_PROVIDER=local
# local provider:
LOCAL_STORAGE_BASE_DIR=./storage
LOCAL_STORAGE_PUBLIC_BASE_URL=
# signing + presign TTL for local provider upload links
STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret-0000
PRESIGN_TTL_SECONDS=120
# s3 provider (S3, Cloudflare R2, or MinIO):
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=marketplace
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=

# Image processing limits
MAX_IMAGE_FILE_MB=10
IMAGE_MAX_DIMENSION=1600
THUMBNAIL_SIZE=300
